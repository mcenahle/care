import Footer from "../components/Footer.astro";

import "ucla-design-systems/build/css/ucla-lib.min.css";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>mcenahle.care</title>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>

  <script>
    import { Navigation } from "ucla-design-systems/build/js/ucla-lib-scripts.esm.js";

    Navigation.initAll();
  </script>
</html>
