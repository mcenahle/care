---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const title = "医学论文";
---

<Layout title={title}>
  <div class="container">
    <h2>{title}</h2>
    <h3>中华医学期刊全文数据库（上海图书馆）</h3>
    <a
      class="ucla-related-link"
      href="https://z.library.sh.cn/go?url=http://www.yiigle.com/index"
      target="_blank"
    >
      馆外访问（成为上海图书馆读者以访问）
      <Icon name="mdi:open-in-new" class="external-18" />
    </a>
    <a
      class="ucla-related-link"
      href="https://z.library.sh.cn/go-anonymous?url=http://www.yiigle.com/index"
      target="_blank"
    >
      馆内访问（成为上海图书馆读者，并在图书馆内连接无线局域网以访问）
      <Icon name="mdi:open-in-new" class="external-18" />
    </a>
  </div>
</Layout>
