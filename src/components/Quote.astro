---
import { Icon } from "astro-icon/components";
---

<div class="ucla-banner__quote">
  <div class="container">
    <div class="ucla">
      <div class="col span_10_of_12" style="margin: 0 auto;">
        <div class="ucla-banner__quote-body">
          <img
            class="ucla-banner__quote-image"
            src="../images/Florence_Nightingale.jpg"
            alt="Florence Nightingale"
          />
          <div class="ucla-banner__quote-content">
            <figure>
              <blockquote cite="https://www.ucla.edu">
                <p>Nursing is an art;</p>
              </blockquote>
              <figcaption><cite>Florence Nightingale</cite></figcaption>
            </figure>
            <a
              class="ucla-btn ucla-btn--secondary-light ucla-btn--icon-trail"
              href="https://zh.wikipedia.org/wiki/%E5%BC%97%E7%BE%85%E5%80%AB%E6%96%AF%C2%B7%E5%8D%97%E4%B8%81%E6%A0%BC%E7%88%BE"
              target="_blank"
              >wikipedia 关于南丁格尔的介绍 <Icon name="mdi:open-in-new" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
