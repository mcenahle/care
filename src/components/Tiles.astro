---
import { Icon } from "astro-icon/components";
---

<div class="ucla" style="margin-top: calc(1.5rem - .75rem);">
  <div class="col span_6_of_12-lg">
    <a href="/papers/" class="ucla-tile">
      <div class="ucla-tile__body">
        <h4 class="ucla-tile__title">
          医学论文 <Icon name="mdi:arrow-top-right" />
        </h4>
        <p class="ucla-tile__text">阅读医学论文与病例后的记录。</p>
      </div>
    </a>
  </div>

  <div class="col span_6_of_12-lg">
    <a href="/thoughts/" class="ucla-tile">
      <div class="ucla-tile__body">
        <h4 class="ucla-tile__title">
          见闻 <Icon name="mdi:arrow-top-right" />
        </h4>
        <p class="ucla-tile__text">不只是医学，还有自己的所见。</p>
      </div>
    </a>
  </div>
</div>
