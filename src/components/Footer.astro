---
import { Icon } from "astro-icon/components";
---

<div class="ucla-global-footer">
  <div class="ucla-global-footer__container">
    <p class="ucla-global-footer__copyright">
      &copy; <span id="ucla-global-footer__copyright-year"> </span> mcenahle.care.
      Made by
      <a
        class="copy__link-a dark"
        style="margin-left: 4px;"
        href="https://designsystem.brand.ucla.edu/"
        target="_blank"
        ><u>the design system of UCLA</u> <Icon name="mdi:open-in-new" /></a
      >
    </p>

    <ul class="ucla-global-footer__list">
      <li class="ucla-global-footer__list-item">
        <a
          class="ucla-global-footer__link"
          href="https://mcenahle.page/"
          target="_blank"
          ><u>mcenahle.page</u> <Icon name="mdi:open-in-new" /></a
        >
      </li>
      <li class="ucla-global-footer__list-item">
        <a
          class="ucla-global-footer__link"
          href="https://mcenahle.dev/"
          target="_blank"><u>mcenahle.dev</u> <Icon name="mdi:open-in-new" /></a
        >
      </li>
    </ul>
  </div>
</div>

<script>
  document
    .getElementById("ucla-global-footer__copyright-year")
    .appendChild(document.createTextNode(new Date().getFullYear()));
</script>
