---
import { Icon } from "astro-icon/components";
---

<div class="ucla-dept-footer">
  <div class="ucla-dept-footer__container">
    <img class="ucla-dept-footer__logo" src="/images/care.png" alt="Logo" />
    <div class="ucla-dept-footer__body">
      <div class="ucla-dept-footer__info">
        <address class="ucla-dept-footer__info-address">
          A website <i>of the</i> mcenahle FAKE nursing dept.<br
          />地址：上海市崇明区/浦东新区<br /><a href="mailto:hi@mcenahle.page"
            ><u>hi@mcenahle.page</u> <Icon name="mdi:open-in-new" /></a
          >
        </address>
        <ul class="ucla-social">
          <li class="ucla-social__item">
            <a href="https://github.com/mcenahle/" class="ucla-social__link">
              <span class="visuallyhidden">GitHub</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1em"
                height="1em"
                viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
                ></path></svg
              >
            </a>
          </li>
        </ul>
      </div>
      <nav class="ucla-dept-footer__tertiary-nav">
        <div class="ucla-dept-footer__nav-column">
          <h6 class="tertiary-nav-header">本网站快速链接</h6>
          <ul class="ucla-dept-footer__nav">
            <li><a href="/nursing/"><u>护理学</u></a></li>
            <li><a href="/posts/"><u>医学相关文章</u></a></li>
            <li><a href="/papers/"><u>医学论文</u></a></li>
          </ul>
        </div>
        <div class="ucla-dept-footer__nav-column">
          <h6 class="tertiary-nav-header">旗下外部链接</h6>
          <ul class="ucla-dept-footer__nav">
            <li>
              <a href="https://mcenahle.page/" target="_blank"
                ><u>mcenahle.page</u> <Icon name="mdi:open-in-new" /></a
              >
            </li>
            <li>
              <a href="https://mcenahle.dev/" target="_blank"
                ><u>mcenahle.dev</u> <Icon name="mdi:open-in-new" /></a
              >
            </li>
          </ul>
        </div>
      </nav>
    </div>
  </div>
</div>
