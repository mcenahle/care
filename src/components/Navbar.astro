---
import { Icon } from "astro-icon/components";
---

<meta charset="utf-8" />

<nav
  class="navbar navbar-default navbar-fixed-top"
  role="navigation"
  data-pagefind-ignore
>
  <div class="container-fluid">
    <div class="navbar-header">
      <button
        type="button"
        class="navbar-toggle"
        data-toggle="collapse"
        data-target="#example-navbar-collapse"
      >
        <span class="sr-only">切换导航</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a class="navbar-brand" href="/">mcenahle.care</a>
    </div>
    <div class="collapse navbar-collapse" id="example-navbar-collapse">
      <ul class="nav navbar-nav">
        <li class="dropdown">
          <a
            href="javascript:void(0)"
            class="dropdown-toggle"
            data-toggle="dropdown"
          >
            <Icon name="mdi:heart-multiple" /> 感兴趣的学科 <b class="caret"
            ></b>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/nursing/">护理学</a></li>
            <li><a href="/obgyn/">妇产科学</a></li>
          </ul>
        </li>
        <li>
          <a href="/papers/"><Icon name="mdi:book-education" /> 医学论文</a>
        </li>
        <li>
          <a href="/donate-blood/"><Icon name="mdi:hand-heart" /> 献血</a>
        </li>
        <li>
          <a href="/thoughts/"><Icon name="mdi:notebook-edit" /> 见闻</a>
        </li>
        <li>
          <a href="https://mail.mcenahle.care" target="_blank"
            ><Icon name="mdi:email" /> Webmail</a
          >
        </li>
      </ul>
      <ul class="nav navbar-nav navbar-right">
        <li>
          <a
            href="https://mcenahle.dev/gh/care/"
            target="_blank"
            class="btn btn-default"
            style="margin: 8px 10px 8px 10px; padding: 6px 6px 6px 6px;"
            role="button"
            ><Icon name="mdi:github" /> 查看本网站的 GitHub 源代码
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>
